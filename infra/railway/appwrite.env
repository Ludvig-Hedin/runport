_APP_BUILDS_VOLUME=appwrite-builds
_APP_JOBS_HOST=http://orchestrator:8080
_APP_JOBS_ENDPOINT=http://appwrite
_APP_BROWSER_HOST=http://appwrite-browser:3000/v1
_APP_EXECUTOR_RUNTIME_NETWORK=appwrite_runtimes
