# Single public entry for Appwrite on Railway, mirroring the local Traefik
# rules: realtime, then the API, then the admin for everything else.
{
	admin off
	auto_https off
	servers {
		# Railway's edge reaches us from a private address and appends the
		# real client to X-Forwarded-For. Strict mode takes the right-most
		# untrusted entry, so addresses a client adds itself are ignored.
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:{$PORT:8080} {
	# Appwrite reads the first X-Forwarded-For entry, so pass only the
	# client address Caddy worked out above.
	request_header X-Forwarded-For {client_ip}

	handle /health {
		respond "ok" 200
	}
	# Test inbox, password protected by Mailpit itself. Remove with Mailpit.
	handle /_mail* {
		reverse_proxy mailpit.railway.internal:8025
	}
	handle /v1/realtime* {
		reverse_proxy appwrite-realtime.railway.internal:80
	}
	handle /v1/* {
		reverse_proxy appwrite.railway.internal:80
	}
	handle /.well-known/* {
		reverse_proxy appwrite.railway.internal:80
	}
	handle {
		reverse_proxy appwrite-console.railway.internal:3000
	}
}
